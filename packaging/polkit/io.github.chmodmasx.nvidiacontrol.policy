<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <action id="io.github.chmodmasx.nvidiacontrol.power-limit">
    <description>Modify NVIDIA GPU power limit</description>
    <message>Administrator authentication is required to modify the NVIDIA GPU power limit</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/nvidia-control-power-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">apply</annotate>
  </action>
</policyconfig>
